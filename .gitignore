.venv/
__pycache__/
*.py[cod]
.DS_Store
.env
.env.*
!.env.example
data/
/outputs/*
!/outputs/README.md
checkpoints/
.cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/
/calibration/*
!/calibration/scs215_so101.json
!/calibration/scs215_so101.meta.json
!/calibration/history/
!/calibration/README.md
!/calibration/vision/
/calibration/vision/**
!/calibration/vision/README.md
!/calibration/vision/cameras/
!/calibration/vision/cameras/*/
!/calibration/vision/cameras/*/intrinsics.json
!/calibration/vision/rigs/
!/calibration/vision/rigs/*/
!/calibration/vision/rigs/*/hand_eye.json
# The collaborator-supplied results, under the flat names the servo code and the
# offline tests load. Tracked at these paths until the `cameras/<id>/` and
# `rigs/<id>/` asset ids are agreed with the calibration collaborator; the
# absolute machine path the hand-eye file arrived with has been removed.
!/calibration/vision/camera_intrinsics.json
!/calibration/vision/hand_eye_result.json

# Hand-in payloads stay local. Commit only the directory guides.
!/deliverables/
/deliverables/*
!/deliverables/README.md
!/deliverables/assignment-[0-9][0-9]/
/deliverables/assignment-[0-9][0-9]/*
!/deliverables/assignment-[0-9][0-9]/README.md
# Legacy hand-in paths stay ignored during migration.
/assignment2_handin/
/scripts/package_assignment2.py

# Machine-specific hardware configuration
configs/*.local.toml
configs/*.local.json
configs/policy/*.local.json
configs/agent/*.local.toml
configs/agent/*.local.json

# Preserved host-specific diagnostics
/local_artifacts/

# Editor and agent local state (session memory, caches). Anchored to the root:
# an older rule matched the name at any depth and was removed for being too
# broad, which left this directory visible to `git add -A`.
/.workbuddy/

# Versioned Python data tools; raw datasets remain ignored.
!/src/eai_robot/policy/data/
!/src/eai_robot/policy/data/*.py

# API profile secrets produced by agent-config (also covered by .env.*).
configs/agent/*.local.env
