{
  "repository": "EAI-Course-2026/eai_project",
  "permanent_branches": [
    "main",
    "develop"
  ],
  "codeowners": [
    "abraxas914",
    "youzhaozhao",
    "LiHuaZhenRen"
  ],
  "settings": {
    "default_branch": "main",
    "allow_merge_commit": true,
    "allow_squash_merge": false,
    "allow_rebase_merge": false,
    "delete_branch_on_merge": false,
    "description": "SCS215/SO101 robot control, FK/IK desk, LeRobot plugin and reproducible Mac/Windows/CUDA environments."
  },
  "protection": {
    "required_status_checks": {
      "strict": true,
      "checks": [
        {
          "context": "Offline tests (macos-latest)",
          "app_id": 15368
        },
        {
          "context": "Offline tests (windows-latest)",
          "app_id": 15368
        },
        {
          "context": "Windows CUDA training software (no GPU)",
          "app_id": 15368
        }
      ]
    },
    "enforce_admins": true,
    "required_pull_request_reviews": {
      "dismiss_stale_reviews": true,
      "require_code_owner_reviews": true,
      "required_approving_review_count": 1,
      "require_last_push_approval": true
    },
    "restrictions": null,
    "required_linear_history": false,
    "allow_force_pushes": false,
    "allow_deletions": false,
    "required_conversation_resolution": true
  }
}
